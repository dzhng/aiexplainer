{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tokenizerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "threshold": {
            "type": "number"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "required": [
          "probe",
          "prompt",
          "metric",
          "value",
          "threshold",
          "pass"
        ],
        "additionalProperties": false
      }
    },
    "prompts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "tokenizerSha256",
    "evidence",
    "prompts"
  ],
  "additionalProperties": false
}
