{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "counts",
                "embed",
                "attn",
                "rope"
              ]
            },
            {
              "type": "string",
              "pattern": "^fixture-[a-z0-9-]+$"
            }
          ]
        },
        "weightsFile": {
          "type": "string",
          "minLength": 1
        },
        "weightsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tensors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "enum": [
                  "f16",
                  "f32",
                  "u32"
                ]
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "byteOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "dtype",
              "shape",
              "byteOffset",
              "byteLength"
            ],
            "additionalProperties": false
          }
        },
        "training": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string",
              "const": "TinyStoriesV2-GPT4"
            },
            "license": {
              "type": "string",
              "const": "CDLA-Sharing-1.0"
            },
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tokensSeen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "valLoss": {
              "type": "number"
            },
            "wallSeconds": {
              "type": "number",
              "minimum": 0
            },
            "torch": {
              "type": "string"
            },
            "gitSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}(-dirty)?$"
            }
          },
          "required": [
            "dataset",
            "license",
            "seed",
            "steps",
            "tokensSeen",
            "wallSeconds",
            "torch",
            "gitSha"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "probe": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string"
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "threshold": {
                "type": "number"
              },
              "pass": {
                "type": "boolean"
              }
            },
            "required": [
              "probe",
              "prompt",
              "metric",
              "value",
              "threshold",
              "pass"
            ],
            "additionalProperties": false
          }
        },
        "kind": {
          "type": "string",
          "const": "word-counts"
        },
        "tokenizer": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "words"
            },
            "vocabTensor": {
              "type": "string",
              "minLength": 1
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "replace": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "kind",
            "vocabTensor",
            "pattern",
            "replace"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "id",
        "weightsFile",
        "weightsSha256",
        "tensors",
        "evidence",
        "kind",
        "tokenizer"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "id": {
