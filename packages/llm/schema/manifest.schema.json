            }
          ]
        },
        "weightsFile": {
          "type": "string",
          "minLength": 1
        },
        "weightsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tensors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dtype": {
                "type": "string",
                "enum": [
                  "f16",
                  "f32",
                  "u32"
                ]
              },
              "shape": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "byteOffset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "dtype",
              "shape",
              "byteOffset",
